# Local Vite uses same-origin `/api` (proxied to the backend). Do not point
# this at a remote host while developing — that is what causes CORS errors.
VITE_API_URL=/api

# Backend the Vite proxy forwards `/api` and `/socket.io` to:
# VITE_PROXY_TARGET=http://127.0.0.1:4000

# Production builds hosted on *.chedi.in automatically use the shared API:
# https://api.webapp.chedi.in/api
# Do not use api.dashboard.chedi.in — that host is not deployed.
# Override only if the API is on a different host:
# VITE_API_URL=https://api.webapp.chedi.in/api
# VITE_SOCKET_URL=https://api.webapp.chedi.in
